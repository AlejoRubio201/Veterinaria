PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=veterinaria

# Origen(es) del front (Vite). Separa varios con comas
CORS_ORIGIN=http://localhost:5173

# OBLIGATORIO: mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duración del access token (corto) y del refresh token (en días)
JWT_ACCESS_TTL=15m
REFRESH_DAYS=7

# Opcional: crea (si no existe) un administrador al iniciar
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Pon 1 si despliegas detrás de un proxy (Nginx, Render, etc.)
TRUST_PROXY=0
